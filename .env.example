# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este ficheiro para .env e ajuste os valores conforme necessário.
# ==============================================================================

# --- SEGURANÇA & AUTENTICAÇÃO ---
SECRET_KEY=SUPER_SECRET_KEY_DEV_123

# --- BASES DE DADOS (DATABASE-PER-SERVICE) ---
AUTH_DATABASE_URL=sqlite:///./data/auth.db
ESTRUTURA_DATABASE_URL=sqlite:///./data/estrutura.db
MANUTENCAO_DATABASE_URL=sqlite:///./data/manutencao.db
AUDITORIA_DATABASE_URL=sqlite:///./data/auditoria.db

# --- RABBITMQ (EVENT CONSUMER & PUBLISHER) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- PORTS DOS MICROSERVIÇOS ---
GATEWAY_PORT=8000
AUTH_PORT=8001
ESTRUTURA_PORT=8002
MANUTENCAO_PORT=8003
STREAMLIT_PORT=8501

# --- ENDPOINTS DE COMUNICAÇÃO INTER-CONTAINERS ---
AUTH_SERVICE_URL=http://auth-service:8001/graphql
ESTRUTURA_SERVICE_URL=http://estrutura-service:8002/graphql
MANUTENCAO_SERVICE_URL=http://manutencao-service:8003/graphql
GRAPHQL_URL=http://graphql-gateway:8000/graphql